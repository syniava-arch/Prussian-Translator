+WORD_TOKEN_RE = re.compile(r"^[\wа-яёА-ЯЁ-]+$", re.UNICODE)
+PUNCT_TOKEN_RE = re.compile(r"^[^\wа-яёА-ЯЁ]+$", re.UNICODE)
